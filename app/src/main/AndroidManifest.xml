<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 기록에 차 소리를 녹음해 붙인다. FrameKit 녹음 화면은 이 선언이 있을 때만 녹음 버튼을 보이고, 처음 누를 때 권한을 묻는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 영수증을 찍을 때 FrameKit 문서 스캐너가 앱 안 카메라로 테두리를 찾아 자동으로 찍는다. 처음 열 때 권한을 묻고,
         거부하면 기기 카메라 앱으로 한 장을 찍는다. 카메라가 없는 기기도 설치할 수 있게 필수 기능으로 두지 않는다. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".ChageunApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chageun.Starting">
        <!-- 사용자 설정을 읽기 전에는 수집하지 않는다. ChageunApplication이 설정에 따라 켠다. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- 기기 식별자와 광고 신호는 쓰지 않는다. -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- 테스트 광고에 붙는 네이티브 광고 검사 팝업을 끈다. 광고가 로드될 때마다 창이 하나씩 쌓이고 스크롤 내내
             광고 위치를 따라 다시 배치돼 디버그·staging 빌드가 끊겼다. 실제 광고에는 영향이 없다. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ML Kit 모델을 설치 때 미리 받는다. 모듈마다 같은 키를 쓰면 병합이 충돌하므로 여기서 한 번에 적는다.
            ocr: 계기판 주행거리 읽기(feature:home), subject_segment: 내 차 사진 배경 제거(data:history),
            ocr_korean: 영수증 PDF 글자 층(FrameKit framekit-ocr, core:ui)
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr,subject_segment,ocr_korean"
            tools:replace="android:value" />

        <!-- WorkManager는 ChageunApplication이 Hilt worker factory로 초기화한다. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
